      <column caption='Average Tenure' datatype='real' name='[Calculation_1696006272049153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(DATEDIFF(&apos;year&apos;, [Hire Date], TODAY()))' />
