      <column caption='Tenure' datatype='integer' name='[Calculation_1696006271946752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Hire Date], TODAY())' />
      </column>
      <column caption='Average Tenure' datatype='real' name='[Calculation_1696006272049153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(DATEDIFF(&apos;year&apos;, [Hire Date], TODAY()))' />
      </column>
      <column caption='Time-to-Hire' datatype='datetime' name='[Calculation_1696006274207746]' role='dimension' type='ordinal'>
